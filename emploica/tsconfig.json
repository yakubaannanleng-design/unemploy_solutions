{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "features/*": ["./src/features/*"],
      "lib/*": ["./src/lib/*"],
      "components/*": ["./src/components/*"]
    },
    "strict": true
  },
  "exclude": [
    "node_modules",
    "src/components/ui" // Add the directory you want to skip here
  ]
}
